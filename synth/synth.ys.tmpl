# synth/synth.ys.tmpl
#
# Generic Yosys synthesis script for one HWExplore-generated datapath,
# targeting the Sky130 standard-cell library already vendored for the
# X-HEEP ASIC flow. `run_synth.sh` substitutes @SRC@/@TOP@/@LIB@/@JSON@
# and runs this per file -- nothing per-module here.

read_verilog -sv @SRC@
hierarchy -top @TOP@
proc; opt; fsm; opt; memory; opt
techmap; opt
dfflibmap -liberty @LIB@
abc -liberty @LIB@
opt_clean
write_json @JSON@
stat -liberty @LIB@
